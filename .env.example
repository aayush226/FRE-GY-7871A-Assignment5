# Copy this file to .env and fill in your own values. .env is git-ignored: never commit it.
GUARDIAN_API_KEY=your_guardian_key_here

# Bluesky (social media). Use an APP PASSWORD (Settings > Privacy and security > App passwords), not your real password.
BSKY_HANDLE=yourname.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Reddit (optional; only if Reddit approves a "script" app for you)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: a contact email, put in the User-Agent of requests (polite to the free APIs)
CONTACT_EMAIL=
